{
  "name": "@mi-setup/core",
  "version": "0.11.2",
  "etapa": "b",
  "private": true,
  "type": "module",
  "description": "Backend de Mi Setup (API, WebSocket, migraciones)",
  "files": [
    "dist",
    "drizzle",
    "sitio-oficial"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "crear-maestra": "tsx --conditions=development src/cli/crear-maestra.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9",
    "@fastify/static": "^8",
    "@fastify/websocket": "^11",
    "@mi-setup/shared": "workspace:*",
    "@node-rs/argon2": "^2",
    "cheerio": "^1.2.0",
    "discord.js": "14.27.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "fflate": "0.8.3",
    "jose": "^5",
    "pg": "^8.13.1",
    "ssh2": "^1.16.0",
    "ws": "^8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2"
  }
}
