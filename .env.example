# Mi Setup — variables de entorno. Copia a .env y rellena.
# En el VPS, el script mi-setup-vps.sh genera /opt/mi-setup/.env.
# NUNCA subas el .env real al repositorio.

# --- Dominio y hosts ---
DOMAIN=mexicanland.net
APP_HOST=setup.mexicanland.net
NTFY_HOST=ntfy.mexicanland.net
RD_HOST=rd.mexicanland.net
# Clave pública de hbbs (contenido de id_ed25519.pub). No es secreta; se muestra para configurar el cliente.
RD_PUBLIC_KEY=

# --- Base de datos (contenedor misetup-db) ---
POSTGRES_USER=misetup
POSTGRES_DB=misetup
POSTGRES_PASSWORD=
# Solo desarrollo local (en Docker se fija a misetup-db):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Secretos del servidor (generar con: openssl rand -base64 48) ---
JWT_SECRET=
SERVER_ENC_KEY=
MAIL_INBOUND_SECRET=

# --- Notificaciones (ntfy) — tema largo y aleatorio ---
NTFY_TOPIC=
# URL donde core publica avisos. Vacío = https://NTFY_HOST (en Docker se fija a http://ntfy).
NTFY_URL=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_BUDGET_USD=10

# --- IA gratis local (Ollama en el VPS) ---
# Para encenderla: COMPOSE_PROFILES=ia-local y OLLAMA_URL=http://misetup-ollama:11434
# y luego: docker exec misetup-ollama ollama pull llama3.2:3b
# COMPOSE_PROFILES=ia-local
# Antivirus ClamAV para la comunidad del sitio oficial (~1 GB de RAM). Para encender
# los dos a la vez: COMPOSE_PROFILES=ia-local,comunidad
# COMPOSE_PROFILES=comunidad
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b

# --- Pterodactyl ---
PTERO_URL=https://panel.mexicanland.org
PTERO_CLIENT_KEY=
PTERO_APP_KEY=

# --- Discord ---
DISCORD_BOT_TOKEN=

# --- X (Twitter) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
# Costo estimado (USD) que se muestra antes de cada acción. Revisa tu tarifa en developer.x.com.
X_COSTO_PUBLICAR_USD=0.01
X_COSTO_LECTURA_USD=0.005

# --- Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Google / YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kick ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Respaldos ---
# Carpeta del VPS donde el script deja el pg_dump diario (se monta en core de solo lectura).
BACKUP_HOST_DIR=/opt/mi-setup/backups
# Solo desarrollo local sin Docker: carpeta con respaldos para la pantalla Respaldos.
BACKUP_DIR=

# --- Servicios opcionales (también se ponen desde la app: Ajustes → Servicios y claves) ---
# Cada persona puede poner además sus propias claves en Ajustes → Mis claves.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
TMDB_API_KEY=
CURSEFORGE_API_KEY=
# Mis finanzas → Rendimientos: token gratis del SIE de Banxico (CETES del día).
# banxico.org.mx/SieAPIRest → Token. También se puede poner en Ajustes → Servicios y claves.
BANXICO_TOKEN=
CLOUDFLARE_API_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Opcionales de core ---
# Edición al compilar la imagen: personal (todo) o publica (la de la comunidad).
EDICION=personal
LOG_LEVEL=info
# Carpetas (vacío = valores por defecto; en Docker ya vienen fijadas)
UI_DIR=
UPLOADS_DIR=
# Solo desarrollo: 1 = Postgres embebido en .data/pglite (sin Docker). Prohibido en producción.
DB_EMBEBIDA=
