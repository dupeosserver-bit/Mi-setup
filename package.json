{
  "name": "mi-setup",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "etapa": "b",
  "description": "Mi Setup — app personal PC + celular para operar MexicanLand",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mi-setup/core --filter @mi-setup/ui dev",
    "branding": "node scripts/branding.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ignore-pattern \"apps/mobile/android/**\" --ignore-pattern \"apps/desktop/release/**\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "png-to-ico": "^2",
    "sharp": "^0.33",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
