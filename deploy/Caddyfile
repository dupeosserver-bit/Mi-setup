# Caddy: único servicio expuesto (80/443). HTTPS automático con Let's Encrypt.
# Los hosts vienen de APP_HOST y NTFY_HOST (docker-compose.yml).

# Mientras core se reinicia (al actualizar) Caddy espera hasta 30 s en vez de responder 502.

# Sitios hechos con el creador (nombre.DOMINIO o dominio propio): Caddy pide el
# certificado al momento, solo si Mi Setup confirma que ese sitio existe y está publicado.
{
	on_demand_tls {
		ask http://core:3000/api/sitios/tls
	}
}

(core) {
	reverse_proxy core:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

{$APP_HOST} {
	encode zstd gzip
	header -Server
	import core
}

{$NTFY_HOST} {
	header -Server
	reverse_proxy ntfy:80
}

# Sitios extra que viven fuera de la app (no se borran al actualizar):
# cada archivo /opt/mi-setup/caddy/*.caddy del VPS (p. ej. el panel de Pterodactyl).
# Para llegar a un servicio del propio VPS usa host.docker.internal:PUERTO.
import /etc/caddy/sitios/*.caddy

# Cualquier otro dominio que apunte aquí: los sitios del creador (con certificado bajo demanda).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header -Server
	import core
}
