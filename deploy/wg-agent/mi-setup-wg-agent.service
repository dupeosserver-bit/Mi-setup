[Unit]
Description=Mi Setup: servicio VPN (WireGuard) para el contenedor core
After=network-online.target wg-quick@wg0.service
Before=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/mi-setup/wg-agent/mi-setup-wg-agent.py
Environment=MI_SETUP_WG_GID=1000
# /run/mi-setup se crea en cada arranque; el contenedor solo necesita poder entrar.
RuntimeDirectory=mi-setup
RuntimeDirectoryMode=0751
RuntimeDirectoryPreserve=yes
Restart=on-failure
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
